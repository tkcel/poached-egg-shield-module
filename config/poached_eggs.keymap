#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        // BASE: 4行5列は無効、4行10列はBackspace。
        default_layer {
            bindings = <
                &kp TAB          &kp Q            &kp W            &kp E            &kp R            &kp T                &kp Y            &kp U            &kp I            &kp O            &kp P            &kp BSPC
                &kp LCTRL        &kp A            &kp S            &kp D            &kp F            &kp G                &kp H            &kp J            &kp K            &kp L            &kp SEMI         &kp RET
                &kp LSHFT        &kp Z            &kp X            &kp C            &kp V            &kp B                &kp N            &kp M            &kp COMMA        &kp DOT          &kp UP           &kp RSHFT
                &kp LA(LG(N6))   &kp LALT         &kp LGUI         &kp LGUI         &none            &lt 2 LANG2      &lt 1 SPACE          &lt 1 SPACE      &lt 2 LANG1      &kp BSPC         &kp FSLH         &kp LEFT         &kp DOWN         &kp RIGHT
            >;
        };

        // NUM: meteorite40の数字・記号配置。左上はEsc。その他はBASEを使用。
        num_layer {
            bindings = <
                &kp ESC          &kp N1           &kp N2           &kp N3           &kp N4           &kp N5               &kp N6           &kp N7           &kp N8           &kp N9           &kp N0           &trans
                &trans           &trans           &trans           &trans           &trans           &trans               &kp GRAVE        &kp SQT          &kp EQUAL        &kp BSLH         &kp SEMI         &trans
                &trans           &trans           &trans           &trans           &trans           &trans               &kp MINUS        &kp FSLH         &kp LBKT         &kp RBKT         &trans           &trans
                &trans           &trans           &trans           &trans           &trans           &trans           &trans               &trans           &trans           &trans           &trans           &trans           &trans           &trans
            >;
        };

        // ARROW: I/J/K/Lと既存の矢印位置で通常のカーソル移動。
        arrow_layer {
            bindings = <
                &none            &none            &none            &none            &none            &none                &none            &none            &kp UP           &none            &none            &none
                &trans           &none            &none            &none            &none            &none                &none            &kp LEFT         &kp DOWN         &kp RIGHT        &none            &none
                &trans           &none            &none            &none            &none            &none                &none            &none            &none            &none            &kp UP           &none
                &mo 3            &trans           &trans           &trans           &none            &trans           &trans               &none            &trans           &none            &none            &kp LEFT         &kp DOWN         &kp RIGHT
            >;
        };

        // Bluetooth管理: ARROWの左下を長押し。
        bt_layer {
            bindings = <
                &bt BT_CLR       &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2     &bt BT_SEL 3     &bt BT_SEL 4         &none            &none            &none            &none            &none            &none
                &studio_unlock   &none            &none            &none            &none            &none                &none            &none            &none            &none            &none            &none
                &none            &none            &none            &none            &none            &none                &none            &none            &none            &none            &none            &none
                &kp O            &kp M            &kp U            &none            &none            &none            &none                &none            &none            &none            &none            &kp K            &kp E            &kp N
            >;
        };
    };
};
